Cell[CellGroupData[{

Cell["Thermal Conductance in BLG-TBG-BLG junction", "Title",
 CellChangeTimes->{{3.9998299991451855`*^9, 
  3.999830002826742*^9}},ExpressionUUID->"5cabfd91-70d2-c044-8773-\
307d37cb1319"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data2", "=", 
    RowBox[{
     RowBox[{"Import", "[", "\"\<TBG_tran3.dat\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"A1", "=", 
  RowBox[{"ListDensityPlot", "[", 
   RowBox[{"data2", ",", 
    RowBox[{"InterpolationOrder", "->", "1"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
