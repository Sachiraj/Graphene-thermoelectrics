  3.999830309108204*^9}},ExpressionUUID->"659fbb29-0231-b349-84dc-\
09fb515d9a5b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data2", "=", 
    RowBox[{
     RowBox[{"Import", "[", "\"\<TBG_tran2.dat\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "9"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"A1", "=", 
  RowBox[{"ListDensityPlot", "[", 
   RowBox[{"data2", ",", 
    RowBox[{"InterpolationOrder", "->", "1"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "3.3"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<GreenPinkTones\>\""}], ",", 
    RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
    RowBox[{"Mesh", "->", "None"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", 
       RowBox[{"AbsoluteThickness", "[", "3", "]"}]}], "]"}]}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[Theta]\[Degree]\>\"", ",", "40", ",", "Black"}], "]"}],
        ",", 
       RowBox[{"Rotate", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<U(eV)\>\"", ",", "40", ",", "Black"}], "]"}], ",", 
         RowBox[{"3", 
          RowBox[{"Pi", "/", "2"}]}]}], "]"}]}], "}"}]}], ",", 
    RowBox[{"FrameTicks", "->", 
