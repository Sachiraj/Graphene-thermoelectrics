             RowBox[{"-", "0.10"}], ",", "\"\<-0.10\>\""}], "}"}]}], "}"}], ",",
          "None"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<0.0\>\""}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<1.0\>\""}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "\"\<2.0\>\""}], "}"}]}], "}"}], ",", "None"}], 
        "}"}]}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "30"}], "]"}]}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"BarLegend", "[", 
