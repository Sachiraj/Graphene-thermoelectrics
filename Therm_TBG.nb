Cell[CellGroupData[{

Cell["Maximum cooling power in BLG-TBG-BLG junction", "Title",
 CellChangeTimes->{{3.9998300538953915`*^9, 
  3.9998300615804157`*^9}},ExpressionUUID->"9248278c-80b4-5342-b840-\
afbd57e60acc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data2", "=", 
    RowBox[{
     RowBox[{"Import", "[", "\"\<TBG_tran3.dat\>\"", "]"}], "[", 
     RowBox[{"[", 
