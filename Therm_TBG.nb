Cell[CellGroupData[{

Cell["\<\
Thermoelectric transport calculation both as quantum heat engine and quantum \
refrigerator in BLG-TBG-BLG junction\
\>", "Title",
 CellChangeTimes->{{3.999830401119425*^9, 3.9998304229767666`*^9}, 
   3.9998305044883957`*^9},ExpressionUUID->"45db0f51-7bd1-1041-b3cf-\
65ffbfac4885"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"SetSharedVariable", "[", "list1", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"list1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ParallelDo", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"P11", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", "*", "kx", "*", "x"}], "]"}], "+", 
            RowBox[{"r1", "*", 
