Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data2", "=", 
    RowBox[{
     RowBox[{"Import", "[", "\"\<TBG_tran4.dat\>\"", "]"}], "[", 
