Cell[CellGroupData[{

Cell["\<\
Calculation of conductance, thermal conductance and Seeback coefficient and \
figure of merit\
\>", "Title",
 CellChangeTimes->{{3.990942904909693*^9, 
  3.9909429272382746`*^9}},ExpressionUUID->"403f2501-22f6-d647-ab3f-\
5a60bbfd0f3b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Kappa]x", "=", 
   RowBox[{"k", 
    SqrtBox[
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Phi]", "]"}], "^", "2"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kx", "=", 
   RowBox[{"k", "*", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ky", "=", 
    RowBox[{"k", "*", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{
      SqrtBox[
       RowBox[{"2", "m", "*", 
        RowBox[{"Abs", "[", "G", "]"}]}]], "/", "hbar"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"Abs", "[", "G", "]"}], "/", "\[Gamma]1"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"Sign", "[", "G", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{"Sign", "[", 
    RowBox[{"G", "-", "u0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"0.054", "*", "9.1", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "31"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hbar", "=", 
   RowBox[{"1.054571817", "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "34"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SqrtBox[
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]], "-", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h2", "=", 
   RowBox[{"1", "/", "h1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qx", "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["ky", "2"], "+", 
        FractionBox[
         SuperscriptBox["dky", "2"], "4"]}], ")"}]}], "+", 
     SqrtBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["ky", "2"], 
        SuperscriptBox["dky", "2"]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"G", "-", "u0"}], "\[Gamma]"], ")"}], "2"]}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]x", "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["ky", "2"], "+", 
       FractionBox[
        SuperscriptBox["dky", "2"], "4"]}], ")"}], "+", 
     SqrtBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["ky", "2"], 
        SuperscriptBox["dky", "2"]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"G", "-", "u0"}], "\[Gamma]"], ")"}], "2"]}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dkx", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dky", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "\[Pi]"}], 
     RowBox[{"3", "*", "a0"}]], "*", "2", 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Gamma]1", ",", 
        RowBox[{"\[Theta]", "==", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"hbar", "^", "2"}], " ", 
           RowBox[{"vf", "^", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"15", " ", "tu"}], ")"}]}], ",", 
        RowBox[{"\[Theta]", "!=", "0"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]1", "=", 
   FractionBox[
    RowBox[{"2", 
     SuperscriptBox["hbar", "2"], 
     SuperscriptBox["vf", "2"]}], 
    RowBox[{"5", "tu"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ae", "=", 
   RowBox[{"1.6", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "19"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tu", "=", 
   RowBox[{"0.4", "*", "0.27", "*", "ae"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vf", "=", 
   SuperscriptBox["10", "6"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"50", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a0", "=", 
   RowBox[{"0.246", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k1p", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"qx", "+", 
        RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{"dkx", "+", 
          RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
    RowBox[{"Abs", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"qx", "+", 
         RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
          RowBox[{"dkx", "+", 
           RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
     "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k1m", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "qx"}], "+", 
        RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{"dkx", "+", 
          RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
    RowBox[{"Abs", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "qx"}], "+", 
         RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
          RowBox[{"dkx", "+", 
           RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
     "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2p", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", "*", "\[Lambda]x"}], "+", 
        RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{"dkx", "+", 
          RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
    RowBox[{"Abs", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"I", "*", "\[Lambda]x"}], "+", 
         RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
          RowBox[{"dkx", "+", 
           RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
     "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2m", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], "*", "\[Lambda]x"}], "+", 
        RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{"dkx", "+", 
          RowBox[{"I", "*", "dky"}]}], ")"}]}], ")"}], "^", "2"}]}], 
    RowBox[{"Abs", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], "*", "\[Lambda]x"}], "+", 
         RowBox[{"I", "*", "ky"}]}], ")"}], "2"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], 
