    SuperscriptBox["10", 
     RowBox[{"-", "31"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hbar", "=", 
   RowBox[{"1.054571817", "*", 
    RowBox[{"10", "^", 
