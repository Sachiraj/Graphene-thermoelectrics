        RowBox[{"(", 
         FractionBox[
          RowBox[{"G", "-", "u0"}], "\[Gamma]"], ")"}], "2"]}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]x", "=", 
   SqrtBox[
    RowBox[{
