Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"nearest", "-", 
    RowBox[{"neighbour", " ", "vectors"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d1", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "a"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "3", "]"}], " ", 
      RowBox[{"a", "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"-", "a"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d3", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], " ", 
       RowBox[{"a", "/", "2"}]}], ",", 
      RowBox[{
       RowBox[{"-", "a"}], "/", "2"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"primitive", " ", "vectors"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"a1", "=", 
   RowBox[{"d1", "-", "d2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a2", "=", 
    RowBox[{"d1", "-", "d3"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nx", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ny", "=", "2"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1A", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"n", " ", "a1"}], "+", 
         RowBox[{"m", " ", "a2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "Nx"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", "Ny"}], "}"}]}], "]"}], ",", "1"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1B", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"#", "+", "d1"}], ")"}], "&"}], "/@", "layer1A"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"AB", " ", "stacking"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shiftAB", "=", "d1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zshift", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0.0"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"layer2A", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "+", "shiftAB", "+", "zshift"}], ")"}], "&"}], "/@", 
    "layer1A"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"layer2B", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"#", "+", "shiftAB", "+", "zshift"}], ")"}], "&"}], "/@", 
     "layer1B"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"keep", " ", "only", " ", "rectangular", " ", "region"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"xmin", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"layer1A", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xmax", "=", 
    RowBox[{"Max", "[", 
     RowBox[{"layer1A", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ymin", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"layer1A", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ymax", "=", 
    RowBox[{"Max", "[", 
     RowBox[{"layer1A", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rectQ", "[", "p_", "]"}], ":=", 
    RowBox[{
     RowBox[{"xmin", "<=", 
      RowBox[{"p", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "<=", "xmax"}], "&&", 
     RowBox[{"ymin", "<=", 
      RowBox[{"p", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "<=", "ymax"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"layer1A", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"layer1A", ",", "rectQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1B", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"layer1B", ",", "rectQ"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"layer2A", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"layer2A", ",", "rectQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"layer2B", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"layer2B", ",", "rectQ"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"atoms1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"layer1A", ",", "layer1B"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"atoms2", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"layer2A", ",", "layer2B"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bondLength", "=", "a"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bonds1", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"0", "<", 
           RowBox[{"Norm", "[", 
            RowBox[{"p", "-", "q"}], "]"}], "<", 
           RowBox[{"1.01", " ", "bondLength"}]}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}], "]"}], ",", "Nothing"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "atoms1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "atoms1"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bonds2", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"0", "<", 
           RowBox[{"Norm", "[", 
            RowBox[{"p", "-", "q"}], "]"}], "<", 
           RowBox[{"1.01", " ", "bondLength"}]}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}], "]"}], ",", "Nothing"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "atoms2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "atoms2"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Black", ",", 
     RowBox[{"AbsoluteThickness", "[", "1.2", "]"}], ",", "bonds1", ",", 
     "bonds2", ",", "Blue", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Disk", "[", 
        RowBox[{"#", ",", "0.10"}], "]"}], "&"}], "/@", "layer1A"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Disk", "[", 
        RowBox[{"#", ",", "0.10"}], "]"}], "&"}], "/@", "layer2A"}], ",", 
     "Red", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Disk", "[", 
        RowBox[{"#", ",", "0.10"}], "]"}], "&"}], "/@", "layer1B"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Disk", "[", 
