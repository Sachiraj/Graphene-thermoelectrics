Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"nearest", "-", 
     RowBox[{"neighbour", " ", "vectors"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d1", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "a"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "3", "]"}], " ", 
        RowBox[{"a", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"-", "a"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], " ", 
        RowBox[{"a", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"-", "a"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"primitive", " ", "vectors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a1", "=", 
     RowBox[{"d1", "-", "d2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a2", "=", 
     RowBox[{"d1", "-", "d3"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Nx", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Ny", "=", "6"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Bottom", " ", "layer"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"layer1A", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"n", " ", "a1"}], "+", 
          RowBox[{"m", " ", "a2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "Nx"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "Ny"}], "}"}]}], "]"}], ",", "1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"layer1B", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", "+", "d1"}], ")"}], "&"}], "/@", "layer1A"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Twist", " ", "angle"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"5", " ", "Degree"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rot", "=", 
     RowBox[{"RotationTransform", "[", "theta", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Top", " ", "layer"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"layer2A", "=", 
     RowBox[{"rot", "/@", "layer1A"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"layer2B", "=", 
     RowBox[{"rot", "/@", "layer1B"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Interlayer", " ", "spacing"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"zsep", "=", "0.35"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bondLength", "=", "a"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"atoms1", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"layer1A", ",", "layer1B"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"atoms2", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"layer2A", ",", "layer2B"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Bottom", " ", "layer", " ", "bonds"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bonds1", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"0", "<", 
            RowBox[{"Norm", "[", 
             RowBox[{"p", "-", "q"}], "]"}], "<", 
            RowBox[{"1.01", " ", "bondLength"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Append", "[", 
              RowBox[{"p", ",", "0"}], "]"}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{"q", ",", "0"}], "]"}]}], "}"}], ",", "Nothing"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "atoms1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "atoms1"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Top", " ", "layer", " ", "bonds"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bonds2", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"0", "<", 
            RowBox[{"Norm", "[", 
             RowBox[{"p", "-", "q"}], "]"}], "<", 
            RowBox[{"1.01", " ", "bondLength"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Append", "[", 
              RowBox[{"p", ",", "zsep"}], "]"}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{"q", ",", "zsep"}], "]"}]}], "}"}], ",", "Nothing"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "atoms2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "atoms2"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"A2", "=", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"(*", "bonds", "*)"}], 
       RowBox[{"Black", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"#", ",", "0.025"}], "]"}], "&"}], "/@", "bonds1"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Tube", "[", 
           RowBox[{"#", ",", "0.025"}], "]"}], "&"}], "/@", "bonds2"}], ",", 
        RowBox[{"(*", 
         RowBox[{"lower", " ", "layer", " ", "A"}], "*)"}], 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.1", ",", "0.2", ",", "0.9"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sphere", "[", 
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "0"}], "]"}], ",", "0.12"}], "]"}], "&"}], "/@",
          "layer1A"}], ",", 
        RowBox[{"(*", 
         RowBox[{"lower", " ", "layer", " ", "B"}], "*)"}], 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.9", ",", "0.1", ",", "0.1"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sphere", "[", 
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "0"}], "]"}], ",", "0.12"}], "]"}], "&"}], "/@",
          "layer1B"}], ",", 
        RowBox[{"(*", 
         RowBox[{"upper", " ", "layer", " ", "A"}], "*)"}], 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.3", ",", "0.5", ",", "1.0"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sphere", "[", 
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "zsep"}], "]"}], ",", "0.12"}], "]"}], "&"}], "/@",
          "layer2A"}], ",", 
        RowBox[{"(*", 
         RowBox[{"upper", " ", "layer", " ", "B"}], "*)"}], 
        RowBox[{"RGBColor", "[", 
         RowBox[{"1.0", ",", "0.4", ",", "0.4"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sphere", "[", 
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "zsep"}], "]"}], ",", "0.12"}], "]"}], "&"}], "/@",
          "layer2B"}]}], "}"}], ",", 
      RowBox[{"Boxed", "->", "False"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0.55", ",", "2"}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "800"}], ",", 
      RowBox[{"Background", "->", "White"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.991013481896225*^9, 3.9910137008869247`*^9}, {
  3.991013755401037*^9, 3.9910137633883667`*^9}, {3.9910143792914715`*^9, 
  3.991014409996275*^9}, {3.9910148056682053`*^9, 3.9910148088395367`*^9}, {
  3.991015935801197*^9, 3.9910159362106457`*^9}, {3.991016021024006*^9, 
