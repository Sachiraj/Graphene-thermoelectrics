 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SqrtBox[
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]], "-", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h2", "=", 
   RowBox[{"1", "/", "h1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qx", "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
